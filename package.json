{
  "name": "vitest-pool-fastforks",
  "version": "0.0.0",
  "description": "A Vitest pool that isolates test files like forks, with a new Node.js environment per file in reused child processes",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "index.d.ts",
    "src",
    "prebuilds",
    "addon",
    "binding.gyp"
  ],
  "gypfile": false,
  "scripts": {
    "build": "node-gyp rebuild",
    "test": "node test/run.mjs",
    "copy-prebuild": "node scripts/copy-prebuild.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0 <6.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "node-gyp": "13.1.0",
    "vitest": "5.1.0"
  }
}
